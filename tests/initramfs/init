#!/bin/busybox sh
# ruxos's user-space smoke test (busybox): processes, pipes, files, signals, time, memory.
/bin/busybox --install -s /bin
[ -n "$shell" ] && exec /bin/sh
export PATH=/bin
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /tmp
mkdir -p /proc /mnt && mount -t proc proc /proc
fail() { echo "ruxos-test m2: FAIL $*"; poweroff -f; }
t0=$(date +%s); sleep 1; t1=$(date +%s)
[ $((t1 - t0)) -ge 1 ] && [ $((t1 - t0)) -le 2 ] || fail sleep
mkdir -p /tmp/a/b && echo hello > /tmp/a/b/f && [ "$(cat /tmp/a/b/f)" = hello ] || fail files
ln -s /tmp/a/b/f /tmp/link && [ "$(cat /tmp/link)" = hello ] || fail symlink
mv /tmp/a/b/f /tmp/a/g && [ -f /tmp/a/g ] && [ ! -e /tmp/a/b/f ] || fail rename
rm -r /tmp/a && [ ! -e /tmp/a ] || fail rm
(exit 3); [ $? = 3 ] || fail exit-status
[ "$(echo abc | tr a-z A-Z)" = ABC ] || fail pipe
[ "$(seq 1 1000 | sort -rn | head -1)" = 1000 ] || fail sort
n=0; for i in 1 2 3 4 5 6 7 8; do (sleep 0.1; exit $i) & done; wait; echo "background jobs done"
trap 'got=1' USR1; got=0; kill -USR1 $$; [ $got = 1 ] || fail signal
[ "$(dd if=/dev/zero bs=65536 count=256 2>/dev/null | wc -c)" = 16777216 ] || fail dd
x=$(md5sum /bin/busybox) || fail md5sum
echo 'a=1; b=2; echo $((a+b))' > /tmp/s.sh; [ "$(sh /tmp/s.sh)" = 3 ] || fail script
printf '#!/bin/sh\necho shebang $1\n' > /tmp/sb; chmod +x /tmp/sb; [ "$(/tmp/sb x)" = "shebang x" ] || fail shebang
cd /tmp && [ "$(pwd)" = /tmp ] || fail cwd
/bin/abi > /tmp/abi.out 2>&1
grep -v '^ok' /tmp/abi.out
grep -q '^abi: 0 failures' /tmp/abi.out || fail abi
/bin/futex ${futex:-1} > /tmp/futex.out 2>&1
cat /tmp/futex.out
grep -q '^futex: 0 failures' /tmp/futex.out || fail futex
# glibc, dynamically linked (Debian's libc6 and dash in /sysroot)
if [ -d /sysroot ]; then
    mount -t proc proc /sysroot/proc
    mount -t tmpfs tmpfs /sysroot/tmp
    [ "$(chroot /sysroot /usr/bin/dash -c 'echo $((6*7))')" = 42 ] || fail glibc-dash
    chroot /sysroot /abi > /tmp/abi-glibc.out 2>&1
    grep -v '^ok' /tmp/abi-glibc.out
    grep -q '^abi: 0 failures' /tmp/abi-glibc.out || fail abi-glibc
    chroot /sysroot /futex ${futex:-1} > /tmp/futex-glibc.out 2>&1
    cat /tmp/futex-glibc.out
    grep -q '^futex: 0 failures' /tmp/futex-glibc.out || fail futex-glibc
fi
# an ext4 disk: read it, and run Node.js from it when it has Node (the ruwebos system disk)
if [ -b /dev/vda ]; then
    mount -t ext4 -o ro /dev/vda /mnt || fail mount-ext4
    [ -d /mnt/etc ] || fail ext4-lookup
    if [ -x /mnt/usr/local/bin/node ]; then
        mount -t proc proc /mnt/proc
        mount -t sysfs sysfs /mnt/sys
        mount -t devtmpfs devtmpfs /mnt/dev
        mount -t tmpfs tmpfs /mnt/tmp
        cp /tests/basic.js /mnt/tmp/
        chroot /mnt /usr/local/bin/node /tmp/basic.js > /tmp/node.out 2>&1
        grep -v '^ok' /tmp/node.out
        grep -q '^node-test: ok' /tmp/node.out || fail node
        cp /tests/net.js /mnt/tmp/
        ifconfig lo 127.0.0.1 up
        chroot /mnt /usr/local/bin/node /tmp/net.js > /tmp/net.out 2>&1
        grep -v '^ok' /tmp/net.out
        grep -q '^net-test: ok' /tmp/net.out || fail net
        cp /tests/forward.js /mnt/tmp/
        chroot /mnt /usr/local/bin/node /tmp/forward.js ${forward:-3} > /tmp/forward.out 2>&1
        cat /tmp/forward.out
        grep -q '^forward-test: ok' /tmp/forward.out || fail forward
    else
        [ -x /mnt/bin/busybox ] && [ "$(chroot /mnt /bin/busybox echo hi)" = hi ] || fail ext4-exec
    fi
fi
# power-cut test: write forever (the host kills the VM), or mount once to replay the journal
if [ -b /dev/vdb ] && [ -n "$ext4crash" ]; then
    mkdir -p /data
    mount -t ext4 /dev/vdb /data || fail mount-crash
    if [ "$ext4crash" = write ]; then
        echo "ruxos-test crash: writing"
        n=0
        while :; do
            mkdir -p /data/c$((n % 7))
            echo "$n" > /data/c$((n % 7))/f$n
            [ $((n % 5)) = 0 ] && rm -f /data/c$((n % 7))/f$((n - 5))
            [ $((n % 50)) = 0 ] && sync
            n=$((n + 1))
        done
    fi
    umount /data || fail umount-crash
    echo "ruxos-test crash: ok"
    poweroff -f
fi
# ext4 writes on the scratch disk (/dev/vdb, formatted by the host; checked with e2fsck afterwards)
if [ -b /dev/vdb ] && [ -n "$ext4rw" ]; then
    mkdir -p /data
    mount -t ext4 /dev/vdb /data || fail mount-rw
    mkdir -p /data/d1/d2 || fail mkdir
    i=1; while [ $i -le 300 ]; do echo "file $i" > /data/d1/f$i; i=$((i + 1)); done
    dd if=/dev/zero of=/data/big bs=65536 count=256 2>/dev/null || fail big-write
    ln /data/d1/f1 /data/hard && ln -s d1/f2 /data/sym || fail links
    mv /data/d1/f3 /data/d1/d2/g3 && rm /data/d1/f4 && rmdir /data/d1/d2 2>/dev/null
    [ -d /data/d1/d2 ] || fail rmdir-nonempty
    printf '%s' abc > /data/t; printf '%s' def >> /data/t
    [ "$(cat /data/t)" = abcdef ] || fail append
    [ "$(cat /data/sym)" = "file 2" ] && [ "$(cat /data/hard)" = "file 1" ] || fail link-read
    sync
    umount /data || fail umount
    mount -t ext4 /dev/vdb /data || fail remount
    [ "$(cat /data/d1/d2/g3)" = "file 3" ] && [ ! -e /data/d1/f4 ] && [ "$(ls /data/d1 | wc -l)" = 299 ] || fail persist
    [ "$(wc -c < /data/big)" = 16777216 ] || fail big-size
    [ -n "$keep" ] || rm -r /data/d1 /data/big
    umount /data || fail umount2
fi
uname -a
echo "ruxos-test m2: ok"
poweroff -f
